{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:5173",
    "http://127.0.0.1:5173",
    "http://localhost:3000"
  ],
  "AdminAllowedOrigins": [
    "http://localhost:5174"
  ],
  "AdminSettings": {
    "GoogleClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "JwtSecret": "CHANGE_ME_USE_MIN_32_CHARS_RANDOM_SECRET_KEY",
    "JwtIssuer": "majak4-admin",
    "JwtAudience": "majak4-admin-site",
    "JwtExpiryMinutes": 480,
    "AllowedEmails": []
  },
  "Authentication": {
    "GoogleEnabled": true
  },
  "AWS": {
    "Region": "ap-northeast-1"
  },
  "ConnectionStrings": {
    "GameDatabase": "Server=127.0.0.1;Port=3306;Database=majak_game;User=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;CharSet=utf8mb4;",
    "LogDatabase": "Server=127.0.0.1;Port=3306;Database=majak_log;User=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;CharSet=utf8mb4;"
  },
  "GameSettings": {
    "TestEnvironment": false,
    "TrainingAiLevel": "Advanced",
    "GameClientReadyTimeoutMs": 10000,
    "GamePresentationReadyTimeoutMs": 15000,
    "DefaultRoomRate": 1,
    "RoomChargeDefault": 200,
    "RoomChargeGrade": 100
  },
  "AuthRefresh": {
    "TokenDays": 30
  },
  "GameAuth": {
    "JwtSecret": "CHANGE_ME_GAME_AUTH_SECRET_MINIMUM_32_CHARS",
    "JwtIssuer": "majak4-game",
    "JwtAudience": "majak4-client",
    "AccessTokenMinutes": 15
  },
  "Paifu": {
    "S3Bucket": "",
    "S3Prefix": "paifu",
    "RetentionDays": 90,
    "PresignedUrlMinutes": 5,
    "KmsKeyId": ""
  },
  "RuntimeFlag": {
    "SecureLaunching": true,
    "Hangame2005": false,
    "BipSupport": true,
    "GameLog": true,
    "Mrs": true,
    "MrsV3": true,
    "LcsApi": true,
    "SecureSocket": true,
    "NetCafeIpCheck": true
  },
  "ChannelServerSettings": {
    "ServerUrl": "http://localhost:5246",
    "IsPrimaryServer": true,
    "LobbySessionLeaseSeconds": 90,
    "ChannelUrlMap": {}
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  }
}
