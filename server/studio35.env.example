# Copy this file to .env.studio35 and replace every placeholder locally.
DEPLOY_SERVER=STUDIO35_SSH_HOST
DEPLOY_USER=ubuntu
SSH_KEY_PATH=C:\Users\YOUR_NAME\.ssh\studio35-key.pem
API_DOMAIN=STUDIO35_API_DOMAIN
INTERNAL_PORT=5003
REMOTE_PATH=/var/www/majak4-api
SERVICE_NAME=majak4-api
CLIENT_ORIGINS=https://STUDIO35_FRONT_DOMAIN,capacitor://localhost,http://localhost,https://localhost
ADMIN_ORIGINS=https://STUDIO35_ADMIN_DOMAIN
AWS_REGION=ap-northeast-1
PAIFU_S3_BUCKET=STUDIO35_PAIFU_BUCKET
PAIFU_S3_PREFIX=paifu
PAIFU_RETENTION_DAYS=90
PAIFU_PRESIGNED_URL_MINUTES=5
PAIFU_KMS_KEY_ID=
AUTH_PROVIDER=google
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

FRONT_S3_BUCKET=STUDIO35_FRONT_BUCKET
FRONT_CLOUDFRONT_ID=STUDIO35_CLOUDFRONT_ID
FRONT_SITE_URL=https://STUDIO35_FRONT_DOMAIN
FRONT_API_URL=https://STUDIO35_API_DOMAIN
AWS_REGION=ap-northeast-1
VITE_SERVICE_ID=majak4
HANGE_LOGIN_URL=https://top.hange.jp/login/index
HANGE_BANNER_URL=https://static.hange.jp/hangame/easy/majak4/top_bnr.html

GAME_DB_CONNECTION=Server=STUDIO35_MYSQL_GAME_HOST;Port=3306;Database=STUDIO35_MYSQL_GAME_DB;Uid=STUDIO35_MYSQL_GAME_USER;Pwd=STUDIO35_MYSQL_GAME_PASS;CharSet=utf8mb4;Minimum Pool Size=5;Maximum Pool Size=100;
LOG_DB_CONNECTION=Server=STUDIO35_MYSQL_LOG_HOST;Port=3306;Database=STUDIO35_MYSQL_LOG_DB;Uid=STUDIO35_MYSQL_LOG_USER;Pwd=STUDIO35_MYSQL_LOG_PASS;CharSet=utf8mb4;Minimum Pool Size=3;Maximum Pool Size=50;
REDIS_CONNECTION=STUDIO35_REDIS_HOST:6379,password=STUDIO35_REDIS_PASS
