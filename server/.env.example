# Copy this file to .env.hange-alpha. For Studio35, use studio35.env.example.
GAME_DB_CONNECTION=Server=HANGE_MYSQL_GAME_HOST;Port=3306;Database=HANGE_MYSQL_GAME_DB;Uid=HANGE_MYSQL_GAME_USER;Pwd=HANGE_MYSQL_GAME_PASS;CharSet=utf8mb4;Minimum Pool Size=5;Maximum Pool Size=100;
LOG_DB_CONNECTION=Server=HANGE_MYSQL_LOG_HOST;Port=3306;Database=HANGE_MYSQL_LOG_DB;Uid=HANGE_MYSQL_LOG_USER;Pwd=HANGE_MYSQL_LOG_PASS;CharSet=utf8mb4;Minimum Pool Size=3;Maximum Pool Size=50;
REDIS_CONNECTION=HANGE_REDIS_HOST:7000,HANGE_REDIS_HOST:7001,HANGE_REDIS_HOST:7002,password=HANGE_REDIS_PASS,abortConnect=false
