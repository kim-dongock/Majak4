# Copy this file to .env.development or .env.production and set real values

# API base URL. Leave empty in local dev when using Vite proxy.
VITE_API_BASE_URL=

# Environment label used by the client (development | alpha | production)
VITE_ENV=development

# Hangame login URL
VITE_LOGIN_URL=https://top.hange.jp/login/index

# Top banner image URL
VITE_BANNER_IMG_URL=https://static.hange.jp/hangame/easy/majak4/top_bnr.html

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Optional debug flags (1 to enable, 0 to disable)
VITE_DEBUG_SIGNALR=0
VITE_DEBUG_GAME=0
